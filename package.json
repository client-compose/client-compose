{
  "name": "client-compose",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node scripts/copy-conformance-cases.ts",
    "clean": "tsc -b tsconfig.build.json --clean && rm -rf conformance/runner/dist/cases",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"{clients,composers}/typescript/*/test/*.test.ts\" \"codegen/test/*.test.ts\"",
    "conformance": "node conformance/runner/cli.ts composer",
    "codegen": "node codegen/cli.ts",
    "check-packages": "scripts/check-packages.sh",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "go:lint": "scripts/go-lint.sh check",
    "go:fix": "scripts/go-lint.sh fix"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^24.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "publint": "^0.3.25",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.1"
  }
}
