{
  "name": "@client-compose/express",
  "version": "0.3.1",
  "description": "Express adapter for the Client Compose composer.",
  "keywords": [
    "client-compose",
    "server-driven-ui",
    "backend-for-frontend",
    "islands",
    "composer",
    "express"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/client-compose/client-compose.git",
    "directory": "composers/typescript/express"
  },
  "homepage": "https://github.com/client-compose/client-compose/tree/main/composers/typescript/express#readme",
  "bugs": {
    "url": "https://github.com/client-compose/client-compose/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@client-compose/composer": "workspace:*"
  },
  "peerDependencies": {
    "@types/express": "^5.0.0",
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@client-compose/conformance": "workspace:*",
    "express": "5.2.1",
    "@types/express": "5.0.6"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
