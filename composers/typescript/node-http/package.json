{
  "name": "@client-compose/node-http",
  "version": "0.5.2",
  "description": "node:http adapter for the Client Compose composer.",
  "keywords": [
    "client-compose",
    "server-driven-ui",
    "backend-for-frontend",
    "islands",
    "composer",
    "node",
    "http"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/client-compose/client-compose.git",
    "directory": "composers/typescript/node-http"
  },
  "homepage": "https://github.com/client-compose/client-compose/tree/main/composers/typescript/node-http#readme",
  "bugs": {
    "url": "https://github.com/client-compose/client-compose/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "conformance-server": "node conformance-server.ts"
  },
  "dependencies": {
    "@client-compose/composer": "workspace:*"
  },
  "devDependencies": {
    "@client-compose/conformance": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
