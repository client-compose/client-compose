{
  "manifests": "islands",
  "actions": "actions",
  "entities": "entities",
  "appStrings": "app-strings.json",
  "screenStrings": "screen-strings.json",
  "catalog": "strings",
  "targets": {
    "go": {
      "out": "composer-go/contract_gen.go",
      "package": "main"
    },
    "typescript": [
      {
        "out": "composer-ts/src/contract.generated.ts",
        "protocolImport": "@client-compose/composer"
      },
      {
        "out": "tests/src/contract.generated.ts",
        "protocolImport": "@client-compose/protocol"
      },
      {
        "out": "web/src/contract.generated.ts",
        "protocolImport": "@client-compose/react"
      },
      {
        "out": "next/src/contract.generated.ts",
        "protocolImport": "@client-compose/react"
      },
      {
        "out": "react-native/src/contract.generated.ts",
        "protocolImport": "@client-compose/react"
      }
    ]
  }
}
