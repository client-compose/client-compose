{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "paths": {
      "@client-compose/react": ["../../../clients/typescript/react/src/index.ts"],
      "@client-compose/client": ["../../../clients/typescript/core/src/index.ts"],
      "@client-compose/client/proxy": ["../../../clients/typescript/core/src/proxy.ts"],
      "@client-compose/protocol": ["../../../shared/typescript/protocol/src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src"]
}
