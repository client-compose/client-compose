{
  "manifests": "islands",
  "targets": {
    "go": {
      "out": "composer-go/islands_gen.go",
      "package": "main"
    },
    "swift": {
      "out": "ios/Islands.generated.swift"
    },
    "kotlin": {
      "out": "android/Islands.generated.kt",
      "package": "com.example.profile"
    },
    "typescript": [
      {
        "out": "web/src/islands.generated.ts"
      },
      {
        "out": "react-native/src/islands.generated.ts"
      },
      {
        "out": "next/src/islands.generated.ts",
        "protocolImport": "@client-compose/react"
      }
    ]
  }
}
