{
  "type": "post-grid",
  "version": 1,
  "description": "Grid of a user's recent post thumbnails.",
  "props": {
    "type": "object",
    "required": [
      "posts"
    ],
    "properties": {
      "posts": {
        "type": "array",
        "items": {
          "title": "Post",
          "type": "object",
          "required": [
            "id",
            "thumbnailUrl"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "thumbnailUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
