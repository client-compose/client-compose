{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://client-compose.dev/schema/v0/action-request.json",
  "title": "Action request",
  "type": "object",
  "required": ["protocol", "action", "version", "input", "client", "islands"],
  "properties": {
    "protocol": { "const": 0 },
    "action": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "input": { "type": "object" },
    "client": {
      "type": "object",
      "required": ["platform", "appVersion"],
      "properties": {
        "platform": { "type": "string" },
        "appVersion": { "type": "string" },
        "locale": { "type": "string" }
      }
    },
    "islands": {
      "description": "Capabilities, as for screens: island type -> supported versions, so island updates come at versions the client knows.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "integer", "minimum": 1 },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "idempotencyKey": { "type": "string", "minLength": 1 }
  }
}
