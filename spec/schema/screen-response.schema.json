{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://client-compose.dev/schema/v0/screen-response.json",
  "title": "Screen response",
  "type": "object",
  "required": [
    "protocol",
    "screen",
    "islands"
  ],
  "properties": {
    "protocol": {
      "const": 0
    },
    "screen": {
      "type": "string"
    },
    "islands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/island"
      }
    },
    "cache": {
      "type": "object",
      "properties": {
        "maxAge": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "locale": {
      "type": "string",
      "description": "The language the composer answered in (spec §4.7)."
    },
    "plurals": {
      "$ref": "strings-response.json#/properties/plurals"
    }
  },
  "$defs": {
    "island": {
      "type": "object",
      "required": [
        "key",
        "type",
        "version",
        "status"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "ok"
            },
            "props": {
              "type": "object"
            },
            "next": {
              "type": "string",
              "minLength": 1,
              "description": "The island has more pages: an opaque cursor for its next one (spec §4.5)."
            },
            "strings": {
              "type": "object",
              "description": "The island's strings, in the screen's language (spec §4.7).",
              "additionalProperties": {
                "$ref": "strings-catalog.json#/$defs/template"
              }
            }
          },
          "required": [
            "props"
          ]
        },
        {
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                }
              }
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
}
