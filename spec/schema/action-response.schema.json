{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://client-compose.dev/schema/v0/action-response.json",
  "title": "Action response (200)",
  "type": "object",
  "required": ["protocol", "action", "version", "status"],
  "properties": {
    "protocol": { "const": 0 },
    "action": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["ok", "error"] },
    "result": { "type": "object" },
    "effects": {
      "type": "object",
      "properties": {
        "changes": { "type": "array", "items": { "$ref": "#/$defs/entityChange" } },
        "invalidate": { "type": "array", "items": { "$ref": "#/$defs/screenRef" } },
        "update": { "type": "array", "items": { "$ref": "#/$defs/islandUpdate" } },
        "navigate": { "$ref": "#/$defs/screenRef" }
      }
    },
    "error": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "object" }
      }
    }
  },
  "oneOf": [
    { "properties": { "status": { "const": "ok" } }, "required": ["result"] },
    { "properties": { "status": { "const": "error" } }, "required": ["error"] }
  ],
  "$defs": {
    "entityChange": {
      "type": "object",
      "required": ["entity", "id"],
      "properties": {
        "entity": { "type": "string" },
        "id": { "type": "string" },
        "set": { "type": "object", "description": "Properties that changed, with their new values." },
        "delete": { "const": true }
      },
      "oneOf": [{ "required": ["set"] }, { "required": ["delete"] }]
    },
    "islandUpdate": {
      "type": "object",
      "required": ["screen", "params", "island"],
      "properties": {
        "screen": { "type": "string" },
        "params": {
          "description": "The screen's exact params.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "island": { "$ref": "screen-response.json#/$defs/island" }
      }
    },
    "screenRef": {
      "type": "object",
      "required": ["screen"],
      "properties": {
        "screen": { "type": "string" },
        "params": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
