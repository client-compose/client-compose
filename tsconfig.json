{
  // Type-checks everything (sources, tests, examples of use) without emitting. See tsconfig.build.json for builds.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["shared/typescript", "composers/typescript", "clients/typescript", "conformance/runner", "codegen", "examples/todo/composer-ts", "examples/todo/tests"],
  "exclude": ["**/node_modules", "**/dist"]
}
