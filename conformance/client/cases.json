{
  "$comment": "Client conformance cases (spec §8.2). For each case: register a test renderer for every type/version in `registered`, check the declared capabilities, read `stream` (the lines of a screen's stream, spec §4.6, each sent as one line of JSON) to its end, putting the screen together, plan it, and render. The test renderer outputs \"{type}@{version}:{props.v}\". When `renderErrors` is true, also install an error fallback that outputs \"error:{key}:{error.code}\". `expectSkipped` lists keys of islands the client reported as skipped (unknown type/version/status or undecodable props). Cases with `typedOnly` apply only to clients that decode props into typed structures (Swift, Kotlin); untyped clients (TypeScript) skip them.",
  "cases": [
    {
      "name": "declares capabilities sorted ascending",
      "registered": {
        "profile-header": [
          2,
          1
        ],
        "post-grid": [
          1
        ]
      },
      "expectCapabilities": {
        "profile-header": [
          1,
          2
        ],
        "post-grid": [
          1
        ]
      },
      "expectRendered": [],
      "expectSkipped": [],
      "stream": [
        {
          "kind": "head",
          "protocol": 0,
          "screen": "s",
          "islands": []
        },
        {
          "kind": "end"
        }
      ]
    },
    {
      "name": "renders in order with the matching version",
      "registered": {
        "profile-header": [
          1,
          2
        ],
        "post-grid": [
          1
        ]
      },
      "expectCapabilities": {
        "profile-header": [
          1,
          2
        ],
        "post-grid": [
          1
        ]
      },
      "expectRendered": [
        "post-grid@1:7",
        "profile-header@2:3"
      ],
      "expectSkipped": [],
      "stream": [
        {
          "kind": "head",
          "protocol": 0,
          "screen": "s",
          "islands": [
            {
              "key": "posts",
              "type": "post-grid",
              "version": 1,
              "status": "ok",
              "props": {
                "v": 7
              }
            },
            {
              "key": "header",
              "type": "profile-header",
              "version": 2,
              "status": "ok",
              "props": {
                "v": 3
              }
            }
          ]
        },
        {
          "kind": "end"
        }
      ]
    },
    {
      "name": "omits errored islands by default",
      "registered": {
        "profile-header": [
          1
        ],
        "post-grid": [
