              "status": "ok",
              "props": {
                "v": 1
              }
            },
            {
              "key": "posts",
              "type": "post-grid",
              "version": 1,
              "status": "error",
              "error": {
                "code": "timeout",
                "retryable": true
              }
            }
          ]
        },
        {
          "kind": "end"
        }
      ]
    },
