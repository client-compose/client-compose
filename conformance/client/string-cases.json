{
  "$comment": "Client string fixtures (spec §4.7). For each case, a client filling in `template` with `values`, using the plural rules of `language` from spec/plurals.json, must produce `expect`.",
  "cases": [
    {
      "name": "text without params is itself",
      "language": "en",
      "template": "Latest articles",
      "values": {},
      "expect": "Latest articles"
    },
    {
      "name": "params fill their slots",
      "language": "en",
      "template": "{count} of {total} uploaded",
      "values": {
        "count": 2,
        "total": 3
      },
      "expect": "2 of 3 uploaded"
    },
    {
      "name": "a slot without a value is left as it is",
      "language": "en",
      "template": "Hi {name}",
      "values": {},
      "expect": "Hi {name}"
    },
    {
      "name": "an exact number comes first",
      "language": "pl",
      "template": {
        "#0": "No articles",
        "#1": "{count} artykuł",
        "#few": "{count} artykuły",
        "#*": "{count} artykułów"
      },
      "values": {
        "count": 0
      },
      "expect": "No articles"
    },
    {
      "name": "then the language's category: few",
      "language": "pl",
      "template": {
        "#0": "No articles",
        "#1": "{count} artykuł",
        "#few": "{count} artykuły",
        "#*": "{count} artykułów"
      },
      "values": {
        "count": 23
      },
      "expect": "23 artykuły"
    },
    {
      "name": "a category without a variant falls to #*",
      "language": "pl",
      "template": {
        "#0": "No articles",
        "#1": "{count} artykuł",
        "#few": "{count} artykuły",
        "#*": "{count} artykułów"
      },
      "values": {
        "count": 5
      },
      "expect": "5 artykułów"
    },
    {
      "name": "one, in English, by its exact number",
      "language": "en",
      "template": {
        "#1": "{count} article",
        "#*": "{count} articles"
      },
      "values": {
        "count": 1
      },
      "expect": "1 article"
    },
    {
      "name": "anything else, #*",
      "language": "en",
      "template": {
        "#1": "{count} article",
        "#*": "{count} articles"
      },
      "values": {
        "count": 7
      },
      "expect": "7 articles"
    },
    {
      "name": "a category variant (one) in a language whose 'one' isn't only 1",
      "language": "ru",
      "template": {
        "#one": "{count} рецепт",
        "#few": "{count} рецепта",
        "#*": "{count} рецептов"
      },
      "values": {
        "count": 21
      },
      "expect": "21 рецепт"
    },
    {
      "name": "without a count, variants fall to #*",
      "language": "en",
      "template": {
        "#1": "{count} article",
        "#*": "{count} articles"
      },
      "values": {},
      "expect": "{count} articles"
    }
  ]
}